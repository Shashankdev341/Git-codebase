# Groq API Key (Primary AI Engine — ultra-fast LPU inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (Fallback AI Engine for large context repos)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token (Increases rate limit from 60 to 5,000 requests/hour)
# GITHUB_TOKEN=your_github_token_here
# VITE_GITHUB_TOKEN=your_github_token_here
